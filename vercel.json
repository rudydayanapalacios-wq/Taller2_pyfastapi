{
  "builds": [
    {
      "src": "techgear_web/techgear/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "techgear_web/staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/techgear_web/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "techgear_web/techgear/wsgi.py"
    }
  ]
}